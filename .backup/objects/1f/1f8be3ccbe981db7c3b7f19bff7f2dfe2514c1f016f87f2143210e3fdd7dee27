<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose 应用外壳主题：无 ActionBar，深色窗口底色避免启动白闪 -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zi_window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/zi_brand</item>
    </style>
</resources>